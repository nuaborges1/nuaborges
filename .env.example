# ==============================================================================
# CONFIGURAÇÃO DE INFRAESTRUTURA & ARMAZENAMENTO DE MÍDIA (BACKBLAZE B2)
# ==============================================================================
# IMPORTANTE: Nunca insira tokens reais neste arquivo de exemplo (.env.example).
# Para usar, copie este arquivo para .env.local e preencha com as credenciais.
#
# Cloudflare Pages atua exclusivamente como camada de deploy, CDN e proxy.
# O armazenamento de mídias oficial do projeto é o Backblaze B2 (S3-compatible).
# ==============================================================================

# 1. Provedor de Armazenamento Ativo
# Opções: 'b2' | 's3' | 'local'
MEDIA_STORAGE_PROVIDER=b2

# 2. Credenciais de API S3 do Backblaze B2 (Exclusivas do Servidor / Pages Functions)
# NUNCA prefixe estas variáveis com NEXT_PUBLIC_!
B2_APPLICATION_KEY_ID=seu_key_id_backblaze
B2_APPLICATION_KEY=sua_application_key_backblaze
B2_BUCKET_NAME=nuaborges-media
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Variáveis alternativas S3 padrão (caso prefira):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=nuaborges-media
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=us-east-005

# 3. Domínio Público da CDN de Mídia (Seguro para o Frontend)
NEXT_PUBLIC_MEDIA_CDN_URL=

# 4. URL Base do Site Principal
NEXT_PUBLIC_SITE_URL=https://nuaborges.com.br

# 5. Segurança do Painel Administrativo (/admin)
# Senha mestra corporativa para login no CMS:
ADMIN_PASSWORD=sua_senha_mestra_aqui
# Token de assinatura criptográfica de sessão:
ADMIN_API_SECRET=seu_segredo_de_api_aleatorio_longo

# 6. Banco de Dados Oficial (Supabase PostgreSQL)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# 7. Integração Financeira do Mercado Pago (Exclusivo do Backend / Pages Functions)
# NUNCA prefixe estas credenciais secretas com NEXT_PUBLIC_!
# Access Token de Produção ou Sandbox do Mercado Pago:
MP_ACCESS_TOKEN=APP_USR-seu_access_token_aqui
# Segredo de assinatura do Webhook (para validação criptográfica HMAC SHA-256 via cabeçalho x-signature):
MP_WEBHOOK_SECRET=seu_webhook_secret_aqui
# Chave Pública (opcional, segura para frontend se necessário):
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-sua_chave_publica_aqui

# 8. Envio de E-mails Transacionais (Hostinger SMTP TLS 465 — Exclusivo do Servidor)
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@nuaborges.com.br
SMTP_PASS=sua_senha_smtp_aqui

# 9. Conta de Clientes (NUA ID) e Proteção Anti-Bot (Cloudflare Turnstile)
NUA_ID_SECRET=segredo_aleatorio_longo_para_assinatura_de_sessao_nua_id
TURNSTILE_SECRET_KEY=sua_chave_secreta_turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua_site_key_publica_turnstile

# 10. Lembretes Automáticos de Chamadas VIP (Autenticação do Cron Worker)
CRON_SECRET=segredo_aleatorio_longo_para_cron_de_lembretes
