# ==============================================================================
# CONFIGURAÇÃO DE INFRAESTRUTURA & CLOUDFLARE R2
# ==============================================================================
# IMPORTANTE: Nunca insira tokens reais neste arquivo de exemplo (.env.example).
# Para usar, copie este arquivo para .env.local e preencha com as credenciais.
#
# Para migrar de conta no futuro, basta alterar estas variáveis no painel da
# Cloudflare Pages (Settings > Environment Variables) sem tocar no código!
# ==============================================================================

# 1. Provedor de Armazenamento Ativo
# Opções: 'cloudflare-r2' | 'local'
MEDIA_STORAGE_PROVIDER=cloudflare-r2

# 2. Credenciais de API S3 do Cloudflare R2 (Exclusivas do Servidor / Pages Functions)
# NUNCA prefixe estas variáveis com NEXT_PUBLIC_!
CLOUDFLARE_ACCOUNT_ID=sua_account_id_cloudflare
CLOUDFLARE_R2_ACCESS_KEY_ID=seu_access_key_id_r2
CLOUDFLARE_R2_SECRET_ACCESS_KEY=seu_secret_access_key_r2
CLOUDFLARE_R2_BUCKET_NAME=nuaborges-media

# Endpoint S3 do R2 (opcional se CLOUDFLARE_ACCOUNT_ID estiver definido):
# Exemplo: https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=https://sua_account_id_cloudflare.r2.cloudflarestorage.com

# 3. Domínio Público da CDN de Mídia (Seguro para o Frontend)
# Este é o domínio personalizado apontado para o seu Bucket R2 (ex: cdn.nuaborges.com.br ou r2.dev público)
NEXT_PUBLIC_MEDIA_CDN_URL=

# 4. URL Base do Site Principal (usado para redirecionamentos a partir do subdomínio da CDN)
NEXT_PUBLIC_SITE_URL=https://nuaborges-er7.pages.dev

# 5. Segurança do Painel Administrativo (/admin)
# Senha mestra corporativa para login no CMS:
ADMIN_PASSWORD=sua_senha_mestra_aqui
# Token de assinatura criptográfica de sessão:
ADMIN_API_SECRET=seu_segredo_de_api_aleatorio_longo

# 6. Flag de Ativação do Blog / Diário Secreto em Produção
# 'false' = Oculto em produção (retorna 404 por padrão de segurança)
# 'true'  = Liberado em produção
NEXT_PUBLIC_ENABLE_BLOG=false

# 7. Integração Financeira do Mercado Pago (Exclusivo do Backend / Pages Functions)
# NUNCA prefixe estas credenciais secretas com NEXT_PUBLIC_!
# Access Token de Produção ou Sandbox do Mercado Pago:
MP_ACCESS_TOKEN=APP_USR-seu_access_token_aqui
# Segredo de assinatura do Webhook (para validação criptográfica HMAC SHA-256 via cabeçalho x-signature):
MP_WEBHOOK_SECRET=seu_webhook_secret_aqui
# Chave Pública (opcional, segura para frontend se necessário):
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-sua_chave_publica_aqui

