# ==============================================================================
# SECURITY LEVEL 5 — HARDENED HEADERS CONFIGURATION (CLOUDFLARE PAGES)
# ==============================================================================

# Global Hardened Security Headers
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://cdn.nuaborges.phstatic.com.br https://*.r2.cloudflarestorage.com https://*.pages.dev https://i.ytimg.com https://*.youtube.com; media-src 'self' blob: data: https://cdn.nuaborges.phstatic.com.br https://*.r2.cloudflarestorage.com https://*.googlevideo.com; connect-src 'self' https://cdn.nuaborges.phstatic.com.br https://*.r2.cloudflarestorage.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://www.youtube.com https://*.google.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# HTML documents must revalidate to avoid stale builds across deploys
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# RSC flight payloads must revalidate and have correct component MIME type
/*.txt
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/x-component; charset=utf-8
  X-Content-Type-Options: nosniff

# Immutable Cache for Static Next.js Bundles
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Immutable Cache for Local Optimized Images
/images/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Immutable Cache for Local Audio
/audio/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Dynamic Edge API Endpoints (Anti-Caching & Strict Privacy)
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  X-Content-Type-Options: nosniff
  Pragma: no-cache
  Expires: 0

# Admin Panel Route (Strict Anti-Caching & Frame Blocking)
/admin*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Frame-Options: DENY
