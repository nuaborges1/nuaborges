{
  "name": "nuaborges",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "nua-ai:dev": "node --import tsx tools/nuaAiDevBridge.mjs",
    "functions:dev": "wrangler pages dev public --port 8788 --compatibility-date=2026-09-01",
    "prebuild": "node tools/prepareStaticBuild.mjs",
    "build": "next build",
    "postbuild": "node tools/verifyStaticExport.mjs",
    "build:packages": "node tools/syncPublishedContent.mjs --require-fresh && npm run build && node tools/prepareDeploys.mjs",
    "deploy:admin": "node tools/deployPages.mjs admin",
    "deploy:admingeral": "node tools/deployPages.mjs admingeral",
    "deploy:site": "node tools/deployPages.mjs site",
    "deploy:all": "npm run build:packages && npm run deploy:site && npm run deploy:admin && npm run deploy:admingeral",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "start": "next start",
    "test": "node tests/nuaAiSecretary.test.mjs && node tests/nuaAiSafetyAndMedia.test.mjs && node tests/localApiServer.test.mjs && node tests/mediaSafety.test.mjs && node tests/sha256File.test.mjs && npx tsx tests/publishVsAdminRules.test.mjs && npx tsx tests/nuaAiRealExecution.test.mjs && npx tsx tests/chamadasVip.test.mjs && npx tsx tests/nuaIdIdentity.test.mjs && npx tsx tests/nuaIdCoreFlows.test.mjs && npx tsx tests/persistenceAudit.test.mjs && npx tsx tests/secureId.test.mjs && npx tsx tests/vaultAccess.test.mjs && node --test tests/orderPaymentResume.test.mjs && npx tsx tests/auditRegressions.test.mjs && npx tsx tests/refundEngine.test.mjs",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:api": "vitest run tests/api",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:reliability": "vitest run tests/reliability",
    "test:defects": "vitest run tests/regression",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/qa-gate.mjs smoke",
    "test:regression": "node scripts/qa-gate.mjs regression",
    "test:prelaunch": "node scripts/qa-gate.mjs prelaunch",
    "test:historical-audit": "node scripts/qa-historical-audit.mjs --self-check",
    "test:homologation:preflight": "node scripts/qa-staging-homologation.mjs --preflight",
    "test:homologation": "node scripts/qa-staging-homologation.mjs",
    "test:postdeploy": "node scripts/qa-postdeploy-check.mjs",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "lint": "eslint .",
    "clean": "next clean",
    "postinstall": "node tools/patchXmlBuilder.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@hookform/resolvers": "^5.2.1",
    "@supabase/supabase-js": "^2.117.3",
    "@types/jszip": "^3.4.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.144.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "postcss-selector-parser": ">=6.1.5"
  }
}
