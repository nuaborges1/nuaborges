{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "lib/appointments/types.ts",
    "lib/adminSync.ts",
    "lib/services/nua/appointmentsService.ts",
    "components/nua/admin/ai/ProposalActionCard.tsx",
    "components/nua/admin/appointments/useAppointmentsData.ts",
    "functions/api/supabase/appointments.ts"
  ]
}
