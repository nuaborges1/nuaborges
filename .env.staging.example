# ==============================================================================
# NUA BORGES — TEMPLATE DE AMBIENTE DE HOMOLOGAÇÃO (STAGING)
# ==============================================================================
# Copie para `.env.staging` (ignorado pelo git) ou configure como Secrets no
# Cloudflare Pages Preview (`staging`) e no Worker `reminders-cron --env staging`.
#
# PROIBIDO usar qualquer credencial, banco, bucket ou URL de produção aqui.
# ==============================================================================

# 1. Identificação explícita do ambiente (obrigatório: 'staging')
ENVIRONMENT=staging

# 2. URLs de Homologação (Projetos Cloudflare Pages dedicados de staging — HTTPS obrigatório, NUNCA nuaborges.com.br)
NEXT_PUBLIC_SITE_URL=https://nuaborges-staging.pages.dev
STAGING_SITE_URL=https://nuaborges-staging.pages.dev
STAGING_ADMIN_URL=https://nuaborges-admin-staging.pages.dev
MP_WEBHOOK_URL=https://nuaborges-staging.pages.dev/api/webhooks/mercadopago
# Opcional: hosts extras de homologação separados por vírgula (ex.: staging.nuaborges.com.br)
STAGING_WEBHOOK_HOSTS=

# 3. Supabase Staging (projeto separado, com todas as 7 migrations aplicadas)
SUPABASE_URL=https://SEU-PROJETO-STAGING.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_staging
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_staging

# 4. Mercado Pago Sandbox (Payments API v1 — /v1/payments)
# Aceita credenciais de aplicação TEST-... OU credenciais APP_USR-... de Usuário de Teste (Test Seller)
# desde que MP_SANDBOX_MODE=true (validado em runtime contra GET /users/me exigindo tag "test_user").
MP_ACCESS_TOKEN=TEST-sua_credencial_sandbox_aqui
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-sua_public_key_sandbox_aqui
MP_WEBHOOK_SECRET=segredo_webhook_sandbox_minimo_32_chars
MP_SANDBOX_MODE=true
# Opcional (recomendado ao usar APP_USR- de Usuário de Teste): ID numérico da conta Test Seller
MP_TEST_USER_ACCOUNT_ID=

# 5. Backblaze B2 Staging (bucket exclusivo de homologação, NUNCA nuaborges-media)
MEDIA_STORAGE_PROVIDER=b2
B2_APPLICATION_KEY_ID=sua_key_id_b2_staging
B2_APPLICATION_KEY=sua_application_key_b2_staging
B2_BUCKET_NAME=nuaborges-media-staging
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# 6. SMTP de Teste (caixa postal dedicada de teste / Mailtrap / sandbox)
SMTP_SERVER=sandbox.smtp.mailtrap.io
SMTP_PORT=465
SMTP_USER=usuario_smtp_teste
SMTP_PASS=senha_smtp_teste
STAGING_TEST_EMAIL=homologacao-nua@seu-dominio-de-teste.example
# Opcional: endpoint/API da caixa de teste para verificação automática de recebimento
STAGING_INBOX_CHECK_URL=
STAGING_INBOX_API_TOKEN=

# 7. Segredos Criptográficos EXCLUSIVOS de Staging (nunca reutilize senhas de produção!)
ADMIN_PASSWORD=senha_admin_exclusiva_staging
CLIENT_PASSWORD=senha_cliente_admin_exclusiva_staging
ADMIN_SESSION_SECRET=segredo_sessao_admin_staging_com_pelo_menos_32_caracteres
ADMIN_API_SECRET=segredo_master_api_staging_com_pelo_menos_32_caracteres
NUA_ID_SECRET=segredo_nua_id_staging_com_pelo_menos_32_caracteres
IP_HASH_SECRET=segredo_ip_hash_staging_com_pelo_menos_32_caracteres
CRON_SECRET=segredo_cron_staging_com_pelo_menos_32_caracteres

# 8. Cloudflare Turnstile (chaves de teste do Turnstile em staging)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 9. Controle da Suíte de Homologação (NÃO altere para true sem confirmar isolamento)
STAGING_PACK_SLUG=
STAGING_ALLOW_LIVE_SANDBOX_RUN=false
